{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": { "includeFiles": "data/**" }
    },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/", "dest": "/public/preview.html" },
    { "src": "/preview(\\.html)?", "dest": "/public/preview.html" },
    { "src": "/app(\\.html)?", "dest": "/public/app.html" },
    { "src": "/partner(\\.html)?", "dest": "/public/partner.html" },
    { "src": "/(.+)", "dest": "/public/$1" }
  ]
}
